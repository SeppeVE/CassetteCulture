# Copy this file to .env for local development.
# Vercel: set the same keys per-environment in Project Settings → Environment Variables
# (use a separate Supabase project for staging vs. production — see plan §15).

# ── Supabase ─────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only — never exposed to the client bundle. Used in server/api/* only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile (CAPTCHA on public submit forms) ──
# dash.cloudflare.com → Turnstile → Add Site.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
